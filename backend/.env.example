# ---- Supabase ----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- LLM Provider (OpenAI) ----
OPENAI_API_KEY=

# ---- Debate Engine Tuning ----
MAX_ROUNDS=2
AGENT_TIMEOUT_S=8
MAX_SESSIONS_PER_HOUR=10

# ---- CORS ----
# Local dev: để "*" hoặc "http://localhost:3000"
# Production: domain Vercel thật, KHÔNG dùng "*", nhiều domain cách nhau bằng dấu phẩy
ALLOWED_ORIGINS=http://localhost:3000
